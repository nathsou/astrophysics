// expect: verified
// The binary search from chapter 0, with the overflow-safe midpoint. The indices are 8-bit integers so that
// counterexamples stay small; the argument is the same for 32 or 64 bits.

pred sorted(a: [int]) {
  forall i, j :: 0 <= i < j < len(a) ==> a[i] <= a[j]
}

fn search(a: [int], key: int) -> (r: int)
  requires sorted(a)
  requires len(a) <= 127
  ensures 0 <= r ==> r < len(a) && a[r] == key
  ensures r < 0 ==> key !in a
{
  var lo: i8 = 0
  var hi: i8 = len(a) as i8
  while lo < hi
    invariant 0 <= lo <= hi <= len(a)
    invariant forall i :: 0 <= i < lo ==> a[i] < key
    invariant forall i :: hi <= i < len(a) ==> key < a[i]
    decreases hi - lo
  {
    let mid = lo + (hi - lo) / 2
    if a[mid] < key {
      lo = mid + 1
    } else if key < a[mid] {
      hi = mid
    } else {
      return mid
    }
  }
  return -1
}
