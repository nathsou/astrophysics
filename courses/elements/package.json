    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.10.2",
    "fast-xml-parser": "^5.11.1",
    "typescript": "^7.0.2",
