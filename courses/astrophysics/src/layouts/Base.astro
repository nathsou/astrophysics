---
import '../styles/global.css';
import '../../../../packages/course-navigation/navigation.css';
// KaTeX CSS must match the KaTeX version that renders the maths at build time. rehype-katex 7 bundles
// its own KaTeX 0.16 (nested in its node_modules), whose markup uses class names (.sizing, .strut,
// .sqrt>.root, .stretchy…) that the top-level katex 0.18 stylesheet renamed. With the 0.18 CSS,
// inline fractions, sub/superscript sizes, roots and accents render at the wrong size and overlap.
import '../../node_modules/rehype-katex/node_modules/katex/dist/katex.min.css';
import { parts } from '../course';
import DepthControl from '../components/DepthControl.astro';

interface Props { title: string; description?: string; current?: string; landing?: boolean }
const { title, description = 'An interactive astrophysics course with live simulations.', current, landing = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const published = new Set(
  Object.keys(import.meta.glob('../pages/ch/*.mdx')).map((p) => p.split('/').pop()!.replace('.mdx', '')),
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const r = document.documentElement;
      r.dataset.depth = '2';
      let preference = 'system';
      try {
        if (localStorage.getItem('astrophysics:sidebar') === 'collapsed') r.dataset.sidebar = 'collapsed';
        const saved = localStorage.getItem('theme') ?? localStorage.getItem('cic-theme');
        if (saved === 'light' || saved === 'dark') preference = saved;
        const d = localStorage.getItem('depth');
        if (d === '1' || d === '2' || d === '3') r.dataset.depth = d;
      } catch {}
      r.dataset.theme = preference === 'system'
        ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : preference;
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400;1,6..72,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body data-chapter={current} class:list={[landing && 'landing']}>
    <nav class="course-index-nav" aria-label="Course collection">
      <a class="course-index-link" href={`${base}/../`}><span aria-hidden="true">←</span> All courses</a>
      <button class="course-sidebar-toggle" type="button" aria-controls="course-contents" aria-expanded="true" data-sidebar-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16" /></svg>
        <span data-sidebar-label>Hide contents</span>
      </button>
    </nav>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell course-shell">
      <nav class="sidebar" id="course-contents" aria-label="Course contents">
        <a class="brand" href={`${base}/`}>The <span>Cosmos</span>, Computed</a>
        {parts.map((p) => (
          <>
            <div class="part">{p.appendix ? p.title : <>Part {p.roman} · {p.title}</>}</div>
            <ol>
              {p.chapters.map((c) => (
                <li>
                  {published.has(c.slug) ? (
                    <a href={`${base}/ch/${c.slug}/`} aria-current={current === c.slug ? 'page' : undefined}>
                      <span class="num">{c.n}</span>{c.title}
                    </a>
                  ) : (
                    <span title="Coming soon"><span class="num">{c.n}</span>{c.title}</span>
                  )}
                </li>
              ))}
            </ol>
          </>
        ))}
        <div class="part">Depth of explanation</div>
        <DepthControl compact />
        <div class="tools"><button class="btn" data-action="theme">◐ System</button></div>
      </nav>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <script>
      import { mountSidebar } from '../../../../packages/course-navigation/sidebar';
      mountSidebar('astrophysics');
      import '../scripts/page.ts';
      import '../scripts/islands.ts';
    </script>
  </body>
</html>
