---
import Base from '../layouts/Base.astro';
import DepthControl from '../components/DepthControl.astro';
import { parts } from '../course';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const published = new Set(
  Object.keys(import.meta.glob('./ch/*.mdx')).map((p) => p.split('/').pop()!.replace('.mdx', '')),
);
const main = parts.filter((p) => !p.appendix);
const appendix = parts.filter((p) => p.appendix);
// Number of interactive figures per chapter (counted from the MDX source at build time).
const sources = import.meta.glob('./ch/*.mdx', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const simCount = (slug: string) => (sources[`./ch/${slug}.mdx`]?.match(/<Sim[\s>]/g) ?? []).length;
const sims = (slug: string) => { const n = simCount(slug); return `${n} ${n === 1 ? 'sim' : 'sims'}`; };
const total = parts.reduce((n, p) => n + p.chapters.filter((c) => published.has(c.slug)).length, 0);
const first = main[0]?.chapters.find((c) => published.has(c.slug));
const firstPrimer = appendix[0]?.chapters.find((c) => published.has(c.slug));
---
<Base title="The Cosmos, Computed" landing>
  <div class="page">
    <div class="masthead">
      <span>The Almanac · Vol. I</span>
      <span class="mast-right"><span>Physics · {total} chapters</span><button class="btn" data-action="theme">◐ System</button></span>
    </div>

    <header class="hero">
      <div class="ring r1" aria-hidden="true"></div><div class="ring r2" aria-hidden="true"></div><div class="ring dot" aria-hidden="true"></div>
      <h1>The Cosmos, Computed</h1>
      <p class="lede">From orbits to the cosmic web: the physics of the universe, the equations behind it, and live simulations running on your GPU.</p>
    </header>

    <section class="intro" aria-label="About this course">
      <p class="intro-text">This course is written for people who think in code. Each chapter pairs a full physical explanation, with equations included, with simulations you can take apart. <em>Under the hood</em> sections show the algorithms: integrators, solvers, Monte Carlo methods, ray tracers and FFTs. Physics and computation turn out to be two views of the same thing.</p>
      <div class="home-start">
        <p>Choose how much mathematics you want. Every chapter reads top to bottom at each depth, and you can switch at any time from the chapter header or the sidebar.</p>
        <DepthControl />
        <div class="home-links">
          {first && <a class="btn primary" href={`${base}/ch/${first.slug}/`}>Start with Chapter {first.n}: {first.title} →</a>}
          {firstPrimer && <a class="btn" href="#appendix">Brush up first: the primers ↓</a>}
        </div>
      </div>
    </section>

    <div class="toc" role="list">
      {main.map((p) => (
        <section role="listitem" aria-labelledby={`part-${p.roman}`}>
          <h2 class="part-label" id={`part-${p.roman}`}>{p.roman} · {p.title}</h2>
          <ol>
            {p.chapters.map((c) => (
              <li class:list={[!published.has(c.slug) && 'soon']}>
                {published.has(c.slug) ? (
                  <a href={`${base}/ch/${c.slug}/`}>
                    <span class="row"><span class="n">{String(c.n).padStart(2, '0')}</span><b>{c.title}</b><span class="leader" aria-hidden="true"></span><span class="meta">{sims(c.slug)}</span></span>
                    <span class="blurb">{c.blurb}</span>
                  </a>
                ) : (
                  <div>
                    <span class="row"><span class="n">{String(c.n).padStart(2, '0')}</span><b>{c.title}</b><span class="leader" aria-hidden="true"></span><span class="meta">soon</span></span>
                    <span class="blurb">{c.blurb}</span>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    {appendix.map((p) => (
      <section class="appendix" id="appendix" aria-labelledby="appendix-h">
        <h2 class="part-label" id="appendix-h">Appendix · {p.title.replace(/^Appendix:\s*/, '')}</h2>
        <p class="appendix-intro">Nine short refreshers on the mathematics and physics the chapters lean on, each with its own interactive figures. Read them first, or jump in when a chapter links to one.</p>
        <ol class="toc-list">
          {p.chapters.map((c) => (
            <li class:list={[!published.has(c.slug) && 'soon']}>
              {published.has(c.slug) ? (
                <a href={`${base}/ch/${c.slug}/`}>
                  <span class="row"><span class="n">{c.n}</span><b>{c.title}</b><span class="leader" aria-hidden="true"></span><span class="meta">{sims(c.slug)}</span></span>
                  <span class="blurb">{c.blurb}</span>
                </a>
              ) : (
                <div>
                  <span class="row"><span class="n">{c.n}</span><b>{c.title}</b><span class="leader" aria-hidden="true"></span><span class="meta">soon</span></span>
                  <span class="blurb">{c.blurb}</span>
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>
<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 48px; align-items: start; padding-bottom: 50px; border-bottom: 1px solid var(--fg); margin-bottom: 0; }
  .intro-text { margin: 0; font-size: 1.1rem; line-height: 1.65; }
  .home-start { padding: 1.1rem 1.3rem 1.3rem; border-radius: var(--radius); background: var(--pn); }
  .home-start > p { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--fg-muted); }
  .home-start :global(.depth) { margin-top: 0.9rem; }
  .home-links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.1rem; }
  .home-links .btn { text-decoration: none; padding: 0.5rem 0.8rem; }

  .toc { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0 48px; border-top: 2px solid var(--fg); margin-top: 0; padding-top: 6px; }
  .part-label { color: var(--ac); margin: 0; padding: 18px 0 6px; font-style: normal; font-size: 0.625rem; line-height: 1.5; }
  .part-label::before { display: none; }
  .toc ol, .toc-list { list-style: none; padding: 0; margin: 0; }
  li > a, li > div { display: block; padding: 7px 0 8px; color: var(--fg); text-decoration: none; }
  li > a:hover { opacity: 1; }
  li > a:hover b { color: var(--ac); }
  .row { display: flex; gap: 10px; align-items: baseline; font-size: 1.125rem; line-height: 1.3; }
  .row .n { flex: none; min-width: 22px; font-family: var(--font-mono); font-weight: 500; font-size: 0.6875rem; color: var(--ac); font-variant-numeric: tabular-nums; }
  .row b { font-weight: 400; min-width: 0; }
  .row .leader { flex: 1; min-width: 12px; border-bottom: 1px dotted var(--mute); transform: translateY(-4px); }
  .row .meta { flex: none; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--fg-muted); white-space: nowrap; }
  .blurb { display: block; margin: 2px 0 0 32px; font-size: 0.875rem; line-height: 1.45; color: var(--fg-muted); }
  li.soon b, li.soon .n { color: var(--fg-faint); }

  .appendix { margin-top: 60px; border-top: 2px solid var(--fg); padding-top: 6px; scroll-margin-top: 1.5rem; }
  .appendix-intro { margin: 0 0 14px; max-width: 40rem; font-size: 1rem; line-height: 1.55; color: var(--fg-muted); }
  .toc-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0 48px; }
  .toc-list .row .n { min-width: 26px; }

  @media (max-width: 760px) {
    .intro { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
