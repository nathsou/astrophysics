---
import Base from '../layouts/Base.astro';
import DepthControl from '../components/DepthControl.astro';
import { parts } from '../course';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const published = new Set(
  Object.keys(import.meta.glob('./ch/*.mdx')).map((p) => p.split('/').pop()!.replace('.mdx', '')),
);
const main = parts.filter((p) => !p.appendix);
const appendix = parts.filter((p) => p.appendix);
const first = main[0]?.chapters.find((c) => published.has(c.slug));
const firstPrimer = appendix[0]?.chapters.find((c) => published.has(c.slug));
---
<Base title="The Cosmos, Computed">
  <article class="article home">
    <header class="chapter-head">
      <div class="kicker">An interactive course in astrophysics</div>
      <h1>The Cosmos, Computed</h1>
      <p class="lede">From orbits to the cosmic web: the physics of the universe, the equations behind it, and live simulations running on your GPU.</p>
    </header>
    <p>This course is written for people who think in code. Each chapter pairs a full physical explanation, with equations included, with simulations you can take apart. <em>Under the hood</em> sections show the algorithms: integrators, solvers, Monte Carlo methods, ray tracers and FFTs. Physics and computation turn out to be two views of the same thing.</p>
    <div class="home-start">
      <p>Choose how much mathematics you want. Every chapter reads top to bottom at each depth, and you can switch at any time from the chapter header or the sidebar.</p>
      <DepthControl />
      <div class="home-links">
        {first && <a class="btn primary" href={`${base}/ch/${first.slug}/`}>Start with Chapter {first.n}: {first.title} →</a>}
        {firstPrimer && <a class="btn" href="#appendix">Brush up first: the primers ↓</a>}
      </div>
    </div>

    <div class="wide toc-grid">
      {main.map((p) => (
        <section>
          <div class="part-label">Part {p.roman}</div>
          <h2>{p.title}</h2>
          <ol>
            {p.chapters.map((c) => (
              <li class:list={[!published.has(c.slug) && 'soon']}>
                {published.has(c.slug) ? <a href={`${base}/ch/${c.slug}/`}><b><span class="n">{c.n}.</span> {c.title}</b></a> : <b><span class="n">{c.n}.</span> {c.title}</b>}
                <span>{c.blurb}</span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    {appendix.map((p) => (
      <section class="wide appendix" id="appendix">
        <div class="part-label">Appendix</div>
        <h2>{p.title.replace(/^Appendix:\s*/, '')}</h2>
        <p class="appendix-intro">Nine short refreshers on the mathematics and physics the chapters lean on, each with its own interactive figures. Read them first, or jump in when a chapter links to one.</p>
        <ol class="primer-grid">
          {p.chapters.map((c) => (
            <li class:list={[!published.has(c.slug) && 'soon']}>
              {published.has(c.slug) ? (
                <a href={`${base}/ch/${c.slug}/`}><span class="badge">{c.n}</span><b>{c.title}</b><span>{c.blurb}</span></a>
              ) : (
                <div><span class="badge">{c.n}</span><b>{c.title}</b><span>{c.blurb}</span></div>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </article>
</Base>
<style>
  .home-start { margin: 1.2rem 0 0; padding: 1.1rem 1.3rem 1.3rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg-elev); }
  .home-start > p { margin: 0; font-family: var(--font-ui); font-size: 0.85rem; line-height: 1.55; color: var(--fg-muted); }
  .home-start :global(.depth) { margin-top: 0.9rem; }
  .home-links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.1rem; }
  .home-links .btn { text-decoration: none; font-size: 0.8rem; padding: 0.5rem 0.9rem; }
  .home-links .btn.primary:hover { color: var(--bg); filter: brightness(1.08); }

  .toc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 2.5rem 3rem; margin-top: 3.5rem; }
  .toc-grid h2, .appendix h2 { margin: 0.2rem 0 1rem; font-size: 1.5rem; }
  .part-label { font-family: var(--font-ui); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .toc-grid ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .toc-grid li { display: flex; flex-direction: column; gap: 0.15rem; }
  .toc-grid li a { text-decoration: none; color: var(--fg); }
  .toc-grid li a:hover b { color: var(--accent); }
  .toc-grid li b { font-weight: 500; }
  .toc-grid .n { color: var(--fg-muted); font-variant-numeric: tabular-nums; }
  .toc-grid li > span { font-family: var(--font-ui); font-size: 0.8rem; color: var(--fg-muted); }
  .toc-grid li.soon b { color: var(--fg-faint); }

  .appendix { margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--rule); scroll-margin-top: 1.5rem; }
  .appendix-intro { margin: -0.3rem 0 1.4rem; max-width: 40rem; font-family: var(--font-ui); font-size: 0.85rem; line-height: 1.55; color: var(--fg-muted); }
  .primer-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr)); gap: 0.8rem; }
  .primer-grid li > * {
    display: grid; grid-template-columns: auto 1fr; align-content: start; column-gap: 0.75rem; row-gap: 0.2rem; height: 100%;
    padding: 0.8rem 0.9rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg-elev);
    text-decoration: none; color: var(--fg); transition: border-color 0.15s;
  }
  .primer-grid li > a:hover { border-color: var(--accent); }
  .primer-grid li > a:hover b { color: var(--accent); }
  .primer-grid .badge {
    grid-row: span 2; align-self: start; display: inline-grid; place-items: center; min-width: 2.1rem; height: 1.6rem; padding: 0 0.35rem;
    border-radius: 5px; background: var(--hl); color: var(--accent); font-family: var(--font-ui); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em;
  }
  .primer-grid b { font-weight: 500; font-size: 1.05rem; line-height: 1.3; }
  .primer-grid li > * > span:last-child { font-family: var(--font-ui); font-size: 0.76rem; line-height: 1.45; color: var(--fg-muted); }
  .primer-grid li.soon b { color: var(--fg-faint); }
</style>
